# Protected migration and acceptance job only; never load this in web hosting.
# Match the selected staging deployment and store real values as CI secrets.
TABLESYNC_DEPLOYMENT_ENV="staging"
TABLESYNC_DATABASE_SCOPE="acceptance"
TABLESYNC_DEPLOYMENT_ID=""
TABLESYNC_GIT_SHA=""
TABLESYNC_EXPECTED_MIGRATION="20260908010000_correct_tofu_shopping_category"
NEXT_PUBLIC_APP_URL=""
BETTER_AUTH_URL=""
AUTH_TRUSTED_ORIGINS=""
BETTER_AUTH_SECRET=""

# Both use TLS, point to the same database, and use different roles.
DATABASE_URL=""
DIRECT_URL=""
DATABASE_RUNTIME_MODE="pooled"
DATABASE_POOL_SIZE="8"
DATABASE_POOL_MAX_USES="5000"
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""

# The exact HTTPS origin and a fresh dedicated acceptance account session.
TABLESYNC_E2E_BASE_URL=""
TABLESYNC_LIGHTHOUSE_BASE_URL=""
TABLESYNC_STAGING_SESSION_COOKIE=""
TABLESYNC_STAGING_SESSION_COOKIE_NAME="__Secure-tablesync-auth.session_token"
