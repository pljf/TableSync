# Copy these settings into the hosting provider's environment/secret store.
# Supply the real values there before building; never commit a filled-in copy.
TABLESYNC_DEPLOYMENT_ENV="staging"
TABLESYNC_DATABASE_SCOPE="runtime"
# Vercel: enable "Enable access to System Environment Variables"; its generated
# VERCEL_DEPLOYMENT_ID and VERCEL_GIT_COMMIT_SHA take precedence automatically.
# Leave these empty on Vercel unless provider metadata is unavailable. Other
# hosts and the separate protected acceptance job require explicit values.
TABLESYNC_DEPLOYMENT_ID=""
TABLESYNC_GIT_SHA=""
TABLESYNC_EXPECTED_MIGRATION="20260908010000_correct_tofu_shopping_category"

# Both addresses must identify the same non-local HTTPS origin.
NEXT_PUBLIC_APP_URL=""
BETTER_AUTH_URL=""
AUTH_TRUSTED_ORIGINS=""
BETTER_AUTH_SECRET=""

# TLS-enabled pooled PostgreSQL connection using the limited runtime role.
# DIRECT_URL and the acceptance session Cookie must not be in the web runtime.
DATABASE_URL=""
DATABASE_RUNTIME_MODE="pooled"
DATABASE_POOL_SIZE="8"
DATABASE_POOL_MAX_USES="5000"

# Optional GitHub sign-in: provide both values, or leave both empty.
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""
